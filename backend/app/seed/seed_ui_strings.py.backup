# The other eight languages ship with the same key set, English text as a working placeholder,
# and needs_review=True. Combined with is_active=False on their language_master row (seeded in
# seed_languages.py above), they are fully invisible to riders until MVP1 — a content and
# Super Admin toggle task, not a code task. See Step 7 below.
PENDING_REVIEW_LANGUAGES = [
    "ki",  # Gĩkũyũ (Kikuyu)
    "kam", # Kikamba
    "luo", # Dholuo (Luo)
    "luy", # Luluhya (Luhya)
    "kln", # Kalenjin
    "so",  # Af-Soomaali (Somali)
    "ebu", # Kĩembu (Embu)
    "mer", # Kĩmĩrũ (Meru)
]

def run():
    db = SessionLocal()
    for key, text in STRINGS_EN.items():
        db.merge(UiStringMaster(string_key=key, language_code="en", translated_text=text, needs_review=False))
    for key, text in STRINGS_SW.items():
        db.merge(UiStringMaster(string_key=key, language_code="sw", translated_text=text, needs_review=False))
    for lang_code in PENDING_REVIEW_LANGUAGES:
        for key, text in STRINGS_EN.items():
            db.merge(UiStringMaster(string_key=key, language_code=lang_code, translated_text=text, needs_review=True))
    db.commit()
    db.close()

if __name__ == "__main__":
    run()

