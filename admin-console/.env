# ============================================================================
# ADMIN CONSOLE FRONTEND - .env
# ============================================================================
# CRITICAL FIX: Updated VITE_API_BASE_URL to point to the backend API, not the frontend

# Backend API URL (where the admin-console sends requests)
# MUST match your backend domain: https://smart-boda-api.onrender.com
VITE_API_BASE_URL=https://smart-boda-api.onrender.com

# For development/localhost testing:
# VITE_API_BASE_URL=http://localhost:8000

# Admin Console frontend URL (used by backend for CORS configuration)
VITE_APP_URL=https://smart-boda-admin.onrender.com
