# ============================================================================
# SMART BODA ADMIN CONSOLE - .env Configuration
# ============================================================================
# CRITICAL FIX: VITE_API_BASE_URL must point to backend API, not frontend

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
# CRITICAL: This URL must point to your backend API server, NOT the frontend
# The frontend (admin-console) makes HTTP requests to the backend (API)
#
# Common mistake:
# ❌ VITE_API_BASE_URL=https://smart-boda-admin.onrender.com (WRONG - this is the frontend!)
# ✅ VITE_API_BASE_URL=https://smart-boda-api.onrender.com (CORRECT - this is the backend)
#
# For Development:
# ✅ VITE_API_BASE_URL=http://localhost:8000 (local backend)

VITE_API_BASE_URL=https://smart-boda-api.onrender.com

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# This is the admin console frontend URL (used for CORS configuration on backend)

VITE_APP_URL=https://smart-boda-admin.onrender.com

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Set to true to enable verbose logging during development
VITE_DEBUG_MODE=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Set to true to enable experimental features
VITE_ENABLE_EXPERIMENTAL_FEATURES=false